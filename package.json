{
  "name": "@aibengineering/minecraft-block-highlighter",
  "version": "0.1.0",
  "description": "Transport-agnostic coloured block highlights for Minecraft, with companion NeoForge mod.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun run typecheck && bun test",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aibengineering/minecraft-block-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/aibengineering/minecraft-block-highlighter/issues"
  },
  "homepage": "https://github.com/aibengineering/minecraft-block-highlighter#readme",
  "packageManager": "bun@1.4.0"
}
