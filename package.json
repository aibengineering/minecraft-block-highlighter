{
  "name": "@aibengineering/minecraft-block-highlighter",
  "version": "0.1.0",
  "description": "Transport-agnostic coloured block highlights for Minecraft, with companion NeoForge mod.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "npm run build:ts",
    "build:ts": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "bun run typecheck && bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aibengineering/minecraft-block-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/aibengineering/minecraft-block-highlighter/issues"
  },
  "homepage": "https://github.com/aibengineering/minecraft-block-highlighter#readme"
}
